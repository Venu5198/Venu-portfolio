   "url": "https://github.com/Venu5198/infra",
   "lines": [
    "apiVersion: argoproj.io/v1alpha1",
    "kind: Rollout",
    "metadata:",
    "  name: syncrivo-chat-service",
    "  namespace: production",
    "spec:",
    "  replicas: 12",
    "  strategy:",
    "    canary:",
    "      analysis:",
    "        templates:",
    "          - templateName: prometheus-error-rate",
    "        args:",
    "          - name: service-name",
    "            value: chat-service",
    "      steps:",
    "        - setWeight: 10",
    "        - pause: { duration: 5m }",
    "        - setWeight: 25",
    "        - pause: { duration: 10m }",
    "        - setWeight: 50",
    "        - pause: { duration: 10m }"
   ]
  }

    "",
    "EVENTS_INGESTED = Counter(",
    "    \"syncrivo_events_ingested_total\",",
    "    \"Total incoming platform events\",",
    "    [\"platform\", \"status\"]",
    ")",
    "",
    "PROCESSING_LATENCY = Histogram(",
    "    \"syncrivo_event_processing_seconds\",",
    "    \"End-to-end sync latency across adapters\",",
    "    [\"source_platform\", \"dest_platform\"],",
    "    buckets=(0.01, 0.05, 0.1, 0.25, 0.5, 1.0, 2.5, 5.0)",
    ")",
    "",
    "QUEUE_DEPTH = Gauge(",
    "    \"syncrivo_redis_stream_pending_events\",",
    "    \"Number of pending unprocessed messages in redis stream\",",
    "    [\"consumer_group\"]",
    ")"
